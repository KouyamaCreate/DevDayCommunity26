{
  "name": "sokomade-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/build-ui.mjs && node scripts/build-server.mjs",
    "start": "node src/stdio.mjs",
    "preview": "node src/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:live": "node scripts/check-live.mjs",
    "check": "npm run build && npm test",
    "package": "node scripts/package-plugin.mjs",
    "test:workflows:live": "node scripts/check-web-workflows.mjs",
    "test:cafes:live": "node scripts/check-cafe-workflows.mjs",
    "test:cafes:agent": "node scripts/check-cafe-workflows.mjs --agent-fixtures"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@phosphor-icons/react": "^2.1.10",
    "@turf/boolean-point-in-polygon": "^7.3.4",
    "@turf/buffer": "^7.3.4",
    "@turf/helpers": "^7.3.4",
    "csv-parse": "^6.1.0",
    "iconv-lite": "^0.7.0",
    "ipaddr.js": "^2.2.0",
    "leaflet": "^1.9.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "esbuild": "0.25.12",
    "vite": "6.4.2"
  }
}
